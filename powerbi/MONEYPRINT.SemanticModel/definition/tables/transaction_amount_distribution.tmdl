	column 'Amount Band Label'
		dataType: string
		lineageTag: b0fd6640-a1f4-4588-a566-10738c630c2d
		summarizeBy: none
		sourceColumn: amount_band_label
		sortByColumn: amount_band

	partition transaction_amount_distribution = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Users\user4\Desktop\MONEYPRINT\powerbi\exports\transaction_amount_distribution.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    PromoteHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(PromoteHeaders, {
				        {"transaction_type", type text},
				        {"amount_band", type text},
				        {"transaction_count", Int64.Type},
				        {"total_synthetic_amount", type number},
				        {"fraud_count", Int64.Type},
				        {"transaction_share_within_type", type number},
				        {"source_provenance", type text}
				    }),
				    WithVisualLabel = Table.AddColumn(Typed, "amount_band_label", each let Code = Text.Start([amount_band], 2) in if Code = "01" then "<1K" else if Code = "02" then "1–10K" else if Code = "03" then "10–100K" else if Code = "04" then "100–500K" else if Code = "05" then "500K–1M" else if Code = "06" then "1–5M" else if Code = "07" then "5–10M" else if Code = "08" then "10M+" else [amount_band], type text)
				in
				    WithVisualLabel

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

